DATABASE_URL="postgresql://user:password@localhost:5432/conectavagas"
JWT_SECRET="sua_chave_secreta_aqui"
PORT=3333
# Sessão: 1 hora, sem renovação automática (máximo: 86400 segundos)
JWT_TTL_SECONDS=3600
# Origens exatas, separadas por vírgula, sem barra final
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Limite por IP e rota sensível; janela em milissegundos
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Opcional: interpretação inteligente de currículos via Groq.
# Sem chave, o importador usa o parser local como fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_MS=12000
